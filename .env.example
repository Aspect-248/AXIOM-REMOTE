TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ALLOWED_CHAT_ID=your-numeric-chat-id

# Ask mode (see README) works with no key: sign Claude Code in once with
#   claude auth login --claudeai
# and it runs on your Claude subscription. Optional pay-per-use fallback:
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-opus-5-5          (API backend)
# CLAUDE_CODE_MODEL=sonnet              (Claude Code backend)
# ASK_BACKEND=claude-code               (or: api)
